{
  "name": "a11ymedic",
  "version": "0.1.0",
  "description": "Accessibility checker that explains every problem in plain language and gives the exact fix: 61 WCAG 2.2 rules (color contrast with accessible color suggestions, alt text, labels, ARIA, headings, focus, target size), a browser overlay, a CLI with safe auto fix, CI annotations and test matchers.",
  "keywords": [
    "accessibility",
    "a11y",
    "accessibility checker",
    "website accessibility checker",
    "accessibility testing",
    "accessibility testing in ci",
    "accessibility audit",
    "wcag",
    "wcag 2.2",
    "wcag checker",
    "wcag 2.2 checklist",
    "color contrast",
    "color contrast checker",
    "fix color contrast",
    "contrast ratio",
    "oklch",
    "alt text",
    "alt text checker",
    "aria",
    "aria label",
    "accessible name",
    "form labels",
    "screen reader",
    "keyboard accessibility",
    "focus visible",
    "target size",
    "a11y testing",
    "a11y linter",
    "html linter",
    "auto fix",
    "accessibility overlay",
    "bookmarklet",
    "github actions",
    "vitest",
    "jest",
    "toHaveNoViolations",
    "cli"
  ],
  "homepage": "https://kwy404.github.io/a11ymedic/",
  "bugs": {
    "url": "https://github.com/kwy404/a11ymedic/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kwy404/a11ymedic.git"
  },
  "license": "MIT",
  "author": "Alexandre Kohler (https://github.com/kwy404)",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/a11ymedic.js",
  "jsdelivr": "./dist/a11ymedic.js",
  "bin": {
    "a11ymedic": "dist/cli.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./matchers": {
      "import": {
        "types": "./dist/matchers.d.ts",
        "default": "./dist/matchers.js"
      },
      "require": {
        "types": "./dist/matchers.d.cts",
        "default": "./dist/matchers.cjs"
      }
    },
    "./vitest": {
      "types": "./dist/vitest.d.ts",
      "import": "./dist/vitest.js"
    },
    "./jest": {
      "types": "./dist/jest.d.cts",
      "require": "./dist/jest.cjs",
      "import": "./dist/jest.js"
    },
    "./browser": "./dist/a11ymedic.js",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "matchers": [
        "./dist/matchers.d.ts"
      ],
      "vitest": [
        "./dist/vitest.d.ts"
      ],
      "jest": [
        "./dist/jest.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md"
  ],
  "sideEffects": [
    "./dist/a11ymedic.js",
    "./dist/vitest.js",
    "./dist/jest.js",
    "./dist/jest.cjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . && node scripts/check-chars.mjs",
    "lint:chars": "node scripts/check-chars.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "size": "node scripts/size.mjs",
    "docs": "npm run build && node scripts/build-docs.mjs && node scripts/highlight-docs.mjs",
    "prepublishOnly": "npm run build && npm test",
    "docs:check": "node dist/cli.js \"docs/**/*.html\" --fail-on serious --quiet",
    "art": "bash scripts/art/render.sh"
  },
  "dependencies": {
    "jsdom": "^26.1.0"
  },
  "peerDependencies": {
    "playwright": ">=1.40.0",
    "puppeteer": ">=21.0.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    },
    "puppeteer": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.39.5",
    "parse5": "^7.3.0",
    "shiki": "^3.23.0",
    "tsup": "^8.5.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^3.2.7"
  }
}
